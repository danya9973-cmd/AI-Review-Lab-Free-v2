# API keys stay on this computer and are never sent to the browser.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Stable/default choices as of 2026-09-24. You may replace any model here.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free

# Final synthesis uses one extra call. gemini, groq, or openrouter.
FINAL_PROVIDER=gemini

# Provider switches. Set false to hide/disable a provider without deleting its key.
ENABLE_GEMINI=true
ENABLE_GROQ=true
ENABLE_OPENROUTER=true

# Generation and network limits.
MAX_OUTPUT_TOKENS=1800
REQUEST_TIMEOUT_SECONDS=90
MAX_QUESTION_CHARS=12000

# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=http://127.0.0.1:5000
OPENROUTER_APP_NAME=AI Review Lab Free

# Keep the local-only security boundary.
HOST=127.0.0.1
PORT=5000
DEBUG=false
